<% content_for :title, "Your QR code is ready — GlowQR" %>
<section class="hero result-hero">
  <span class="eyebrow success-badge"><span aria-hidden="true">✓</span> Ready for the real world</span>
  <h1>Your link, <span>with a little glow.</span></h1>
  <p>Your QR code is ready. Download it, share it, put it out there.</p>
</section>

<section class="studio result-studio" aria-label="Your generated QR code">
  <div class="result-art">
    <div class="qr-paper">
      <%= image_tag @qr_code.image, alt: "QR Code", class: "generated-qr", width: 320, height: 320 %>
    </div>
    <span class="format-badge"><%= @qr_code.template_name %> <span aria-hidden="true">·</span> PNG</span>
  </div>
  <div class="result-details">
    <span class="preview-kicker">Good things are a scan away</span>
    <h2>Ready. Set. Share.</h2>
    <p class="result-intro">Your full link is built right into the code.<br>No extra redirect. No missing parameters.</p>
    <div class="destination">
      <h3>Destination URL</h3>
      <p><%= @qr_code.url %></p>
    </div>
    <%= link_to rails_blob_path(@qr_code.image, disposition: "attachment"), download: "qr_#{@qr_code.short_code}.png",
                class: "button button-primary", data: { turbo: false } do %>
      <span aria-hidden="true">↓</span> Download PNG
    <% end %>
    <div class="share-field" data-controller="clipboard">
      <label for="share-url">Share this preview</label>
      <div class="share-input-group">
        <input id="share-url" type="text" value="<%= preview_qr_code_url(@qr_code) %>" readonly data-clipboard-target="input">
        <button type="button" class="button button-secondary" data-action="clipboard#copy">Copy link</button>
      </div>
      <p class="field-hint copy-status" role="status" data-clipboard-target="status"></p>
    </div>
    <%= link_to "← Create another QR code", root_path, class: "text-link" %>
  </div>
</section>
<p class="scan-tip">Before printing, give your code a quick scan with your phone. Keep a clear, light background around it.</p>
