<section class="hero">
  <span class="eyebrow"><span aria-hidden="true">✦</span> A better way to share</span>
  <h1>Make your link <span>stand out.</span></h1>
  <p>One link. A little personality. A QR code ready for the real world.</p>
</section>

<% selected_template = qr_template_options.find { |template| template[:id] == @qr_code.template } || qr_template_options.first %>
<%= form_with url: qr_codes_path, class: "studio", data: { controller: "template-preview" } do |form| %>
  <div class="studio-editor">
    <div class="section-heading">
      <h2>Create your QR code</h2>
      <span class="free-badge">100% free</span>
    </div>

    <% if @qr_code.errors.any? %>
      <div class="form-errors" role="alert" id="form-errors">
        <strong>Let’s fix that link.</strong>
        <ul><% @qr_code.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
      </div>
    <% end %>

    <div class="form-step">
      <%= form.label :url, class: "step-label" do %>
        <span class="step-number" aria-hidden="true">1</span> Add your link
      <% end %>
      <%= form.url_field :url, value: @qr_code.url, placeholder: "https://your-website.com", required: true, maxlength: 2048,
                         autocomplete: "url", spellcheck: false, autocapitalize: "none", class: "url-input",
                         aria: { describedby: @qr_code.errors[:url].any? ? "url-hint form-errors" : "url-hint", invalid: @qr_code.errors[:url].any? } %>
      <p id="url-hint" class="field-hint">Paste the full URL, including any discount codes or query parameters.</p>
    </div>

    <fieldset class="form-step template-fieldset">
      <legend class="step-label"><span class="step-number" aria-hidden="true">2</span> Find your style</legend>
      <div class="template-grid">
        <% qr_template_options.each do |template| %>
          <label class="template-option">
            <%= form.radio_button :template, template[:id], checked: selected_template[:id] == template[:id],
                                  class: "visually-hidden", data: { action: "template-preview#update", template_preview_target: "option",
                                  image: asset_path("qr_samples/#{template[:id]}.png"), name: template[:name] } %>
            <span class="template-card">
              <%= image_tag "qr_samples/#{template[:id]}.png", alt: "", width: 56, height: 56 %>
              <span class="template-copy"><strong><%= template[:name] %></strong><small><%= template[:description] %></small></span>
              <span class="selection-dot" aria-hidden="true"></span>
            </span>
          </label>
        <% end %>
      </div>
    </fieldset>

    <%= form.button class: "button button-primary generate-button", data: { turbo_submits_with: "Creating your QR code…" } do %>
      Generate free QR code <span aria-hidden="true">↗</span>
    <% end %>
    <p class="form-footnote">No signup. No subscription. Just scan & go.</p>
  </div>

  <aside class="studio-preview" aria-label="Style preview">
    <span class="preview-kicker">A little preview</span>
    <div class="sample-card">
      <span class="sample-sparkle" aria-hidden="true">✦</span>
      <%= image_tag "qr_samples/#{selected_template[:id]}.png", alt: "Sample QR code, not yet your link", width: 232, height: 232,
                    class: "sample-qr", data: { template_preview_target: "image" } %>
      <span class="sample-caption">Scan something good.</span>
      <span class="sample-brand" aria-hidden="true">made with GlowQR</span>
    </div>
    <div class="preview-description">
      <h3 data-template-preview-target="name"><%= selected_template[:name] %></h3>
      <p>Pick a style. Make it yours.<br>Your link is encoded when you generate.</p>
    </div>
    <span class="format-badge">PNG download <span aria-hidden="true">·</span> Ready to share</span>
  </aside>
<% end %>

<div class="benefits" aria-label="How it works">
  <p><span aria-hidden="true">↗</span><strong>Any moment</strong> Menus, events, offers & more</p>
  <p><span aria-hidden="true">◇</span><strong>Your link, intact</strong> Query parameters included</p>
  <p><span aria-hidden="true">↓</span><strong>Make it tangible</strong> Download, print & share</p>
</div>
